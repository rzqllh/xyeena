{
  "name": "veyra",
  "version": "1.0.0",
  "description": "Veyra v1.0 — All-in-One Multi-Host AI Agent Skills & Harness Toolkit",
  "type": "module",
  "bin": {
    "veyra": "./bin/veyra.mjs"
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "test:wave1": "node --test tests/wave1/*.test.mjs",
    "preflight": "node scripts/preflight-upstream.mjs",
    "preflight:metadata": "node scripts/preflight-upstream.mjs --metadata-only",
    "preflight:recover": "node scripts/preflight-upstream.mjs --recover-online",
    "continue": "node scripts/continue.mjs",
    "status": "node scripts/continue.mjs",
    "test:all": "node scripts/run-tests.mjs",
    "test:wave2": "node --test tests/wave2/*.test.mjs",
    "test:wave3": "node --test tests/wave3/*.test.mjs",
    "test:wave4": "node --test tests/wave4/*.test.mjs",
    "test:wave5": "node --test tests/wave5/*.test.mjs",
    "test:wave6": "node --test tests/wave6/*.test.mjs"
  },
  "keywords": [
    "veyra",
    "ai-agent",
    "agent-skills",
    "multi-host",
    "gemini",
    "codex",
    "claude-code",
    "cortex"
  ],
  "author": "Hafizh Rizqullah",
  "license": "MIT"
}
