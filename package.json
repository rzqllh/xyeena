{
  "name": "xyeena-agent",
  "version": "0.2.2",
  "description": "Xyeena Rig: selectable Agent Skills and opt-in project Harness with guardrails, audits, and verification.",
  "type": "module",
  "bin": {
    "xyeena-agent": "bin/xyeena.mjs",
    "xyeena": "bin/xyeena.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./core": "./src/index.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "bridges/",
    "skills/",
    "harness/",
    "agents/",
    "schemas/",
    "evals/",
    "plugin.json",
    ".claude-plugin/",
    ".codex-plugin/",
    ".agents/plugins/",
    "rules/",
    "docs/",
    "!docs/audit",
    "!docs/HARNESS-V3.1-IMPORT-PLAN.md",
    "!docs/RELEASE-ACCEPTANCE.md",
    "!docs/XYEENA_TO_ISLAND_HANDOFF.md",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node ./bin/xyeena.mjs check --source .",
    "eval": "node ./bin/xyeena.mjs eval",
    "doctor": "node ./bin/xyeena.mjs doctor --dir .",
    "configure:repo": "node ./scripts/configure-repo.mjs",
    "pack:check": "npm pack --dry-run",
    "test:consumer": "node scripts/consumer-smoke.mjs",
    "test:harness": "node scripts/run-vendored-tests.mjs"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "keywords": [
    "agent-skills",
    "antigravity",
    "claude-code",
    "codex",
    "ai-agents",
    "orchestration",
    "agent-workflow",
    "agent-harness",
    "guardrails",
    "code-quality",
    "verification",
    "developer-tools",
    "security-audit"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rzqllh/xyeena.git"
  },
  "bugs": {
    "url": "https://github.com/rzqllh/xyeena/issues"
  },
  "homepage": "https://github.com/rzqllh/xyeena#readme",
  "publishConfig": {
    "access": "public"
  }
}
