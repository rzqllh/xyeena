{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "statement",
    "status",
    "freshness"
  ],
  "properties": {
    "status": {
      "enum": [
        "VERIFIED",
        "INFERRED",
        "UNKNOWN",
        "ASSUMED"
      ]
    },
    "freshness": {
      "enum": [
        "CURRENT",
        "STALE",
        "SUPERSEDED",
        "INVALID"
      ]
    }
  }
}
